# Скопируйте в .env и заполните. .env в .gitignore.

# Хосты (если пусто -- берутся значения по умолчанию из pm/config.py)
PM_CLOB_HOST=https://clob.polymarket.com
PM_GAMMA_HOST=https://gamma-api.polymarket.com
PM_DATA_HOST=https://data-api.polymarket.com

# Polygon RPC для ончейн-пути Э2 (eth_getTransactionReceipt, только чтение)
PM_RPC_URL=

# НУЖНО ТОЛЬКО для живого теста Э3. Для Э1/Э2/Э4 ОСТАВЬТЕ ПУСТЫМ.
# Если ключ просто лежит в .env, он рано или поздно попадёт в лог или в git.
PM_PRIVATE_KEY=
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=
PM_FUNDER_ADDRESS=

# ОБЯЗАТЕЛЬНО: все свои адреса через запятую (self-exclusion list).
# Пустое значение значит "я готов случайно скопировать самого себя".
PM_SELF_ADDRESSES=

# Куда пишутся артефакты (по умолчанию ./data)
PM_DATA_DIR=data

# Сетевое поведение читающего клиента
PM_REQUEST_TIMEOUT_S=20.0
PM_MAX_RETRIES=3
PM_RATE_LIMIT_RPS=4.0
